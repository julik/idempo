.rspec_status

# Gem lock not required for libraries
Gemfile.lock

# Appraisal lockfiles - regenerated by `appraisal install`. Keeping them checked in
# pinned bundler to the version that generated them, which broke on newer Rubies.
gemfiles/*.gemfile.lock
